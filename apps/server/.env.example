ENV=development
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cortexvault
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/cortexvault

# "inline" runs ingestion in the API process (no Redis, no worker).
# "queue" hands it to an arq worker and requires REDIS_URL.
INGEST_MODE=inline

# Optional. Without it, rate limiting uses per-instance counters, which is
# only correct for a single instance.
REDIS_URL=

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]

# Requests per minute. Auth is keyed per IP; the rest per user.
RATE_LIMIT_AUTH=10
RATE_LIMIT_CHAT=20
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_SEARCH=60

# Chat and embeddings are chosen independently.
# EMBEDDING_DIM must match the provider: gemini 768, openai 1536.
CHAT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq is chat-only (no embeddings endpoint).
# To use it: CHAT_PROVIDER=groq with EMBEDDING_PROVIDER=gemini.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
