ENV=development
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cortexvault
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/cortexvault
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]

# Chat and embeddings are chosen independently.
# EMBEDDING_DIM must match the provider: gemini 768, openai 1536.
CHAT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
